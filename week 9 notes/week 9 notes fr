#Reading from a file
#Method A:read the whole file at once
with open("week 9 notes/stuff.txt","r") as file:
    content=file.read()
    print(content)

    #method B: read the file line by line
with open("week 9 notes/stuff.txt","r") as file:
    for line in file:
        print(line.strip())  #strip() removes leading/trailing whitespace

        #Appending to a file
with open("week 9 notes/stuff.txt","a") as file:
    file.write("This is an appended line.\n")
    file.write("This line will be added to the end of the file.\n")
    #We use R mode to make sure a file exists before we append to it. If the file doesn't exist, we can create it first using W mode.