#countdown Timer
from random import random


seconds=int(input("Enter the time in seconds: "))
while seconds>0:
    if seconds==0:
        print("Almost there!")
    elif seconds==0:
        print("Time's up!")
    else:
        print(seconds)
    seconds-=1

    #Bank Program
balance=1000
while True:
    print(f"{balance},Balance")
    Choice=input("What would you like to do? (deposit, withdraw, exit): ").lower()
    if Choice=="deposit":
        amount=float(input("How much would you like to deposit?"))
        balance+=amount
    elif Choice=="withdraw":
        amount=float(input("How much would you like to withdraw?"))
        if amount <= balance:
            balance-=amount
        else:
            print("Insufficient funds.")
    elif Choice=="exit":
        break
    else:
        print("Invalid choice.")

