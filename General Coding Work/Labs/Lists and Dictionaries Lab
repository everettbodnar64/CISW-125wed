#Dictionaries
#1.	Create an inventory dictionary (e.g., {"Apples": 10, "Bananas": 15, "Oranges": 8}).
#   Give the dictionary at least 5 entries.
#2.	Print a specific item’s stock level using its key.
#3.	Add new stock to the inventory (e.g., add "Grapes").
#4.	Update existing stock quantities (e.g., increase "Apples" by 5).
#5.	Use the .keys() method to retrieve all keys from your dictionary.
#6.	Use the .values() method to retrieve all values from your dictionary.

inventory = {"Apples": 10, "Bananas": 15, "Oranges": 8, "Grapes": 12, "Strawberries": 20}
print(inventory["Apples"])
inventory["Grapes"] = 12
inventory["Apples"] += 5
print(inventory.keys())
print(inventory.values())
keys = inventory.keys()
values = inventory.values()
for key in keys:
    print(key)
    for value in values:
        print (value)
for key, value in inventory.items():
    print(key, value)

